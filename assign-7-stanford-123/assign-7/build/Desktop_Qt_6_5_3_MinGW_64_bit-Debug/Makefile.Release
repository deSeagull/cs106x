####### Compile

release/exp.o: ../../src/exp.cpp ../../src/exp.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o release/exp.o ../../src/exp.cpp

release/parser.o: ../../src/parser.cpp ../../src/exp.h \
		../../src/parser.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o release/parser.o ../../src/parser.cpp

release/sscontroller.o: ../../src/sscontroller.cpp ../../src/ssutil.h \
		../../src/ssmodel.h \
		../../src/ssview.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o release/sscontroller.o ../../src/sscontroller.cpp

release/ssmodel.o: ../../src/ssmodel.cpp ../../src/ssmodel.h \
		../../src/ssview.h \
		../../src/exp.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o release/ssmodel.o ../../src/ssmodel.cpp

release/ssutil.o: ../../src/ssutil.cpp ../../src/ssutil.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o release/ssutil.o ../../src/ssutil.cpp

release/ssview.o: ../../src/ssview.cpp ../../src/ssview.h \
		../../src/ssutil.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o release/ssview.o ../../src/ssview.cpp

